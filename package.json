{
  "name": "im-a-korean-ai-in-seoul",
  "version": "0.2.0",
  "description": "Claude Code로 작업하는 프로젝트에 한국어 작성 지침(output-style)과 문체 검사 hook을 설치합니다.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerdkim/im-a-korean-ai-in-seoul.git"
  },
  "homepage": "https://github.com/nerdkim/im-a-korean-ai-in-seoul#readme",
  "bugs": {
    "url": "https://github.com/nerdkim/im-a-korean-ai-in-seoul/issues"
  },
  "bin": {
    "im-a-korean-ai-in-seoul": "scripts/install.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gate": "node scripts/gate.mjs",
    "self-check": "node scripts/gate.mjs --self-check-only",
    "check": "node scripts/check-korean.mjs --all",
    "rules": "node scripts/check-korean.mjs --rules",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test test/*.test.mjs",
    "install-to": "node scripts/install.mjs",
    "eval": "node scripts/eval-korean.mjs"
  },
  "files": [
    "docs/rules.md",
    "docs/limits.md",
    "scripts/",
    "skill/",
    "output-styles/"
  ],
  "keywords": [
    "korean",
    "style",
    "translationese",
    "honorific",
    "claude-code",
    "hooks"
  ]
}
